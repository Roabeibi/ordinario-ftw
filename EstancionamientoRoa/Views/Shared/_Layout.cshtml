<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - EstancionamientoRoa</title>
<script type="importmap"></script>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/EstancionamientoRoa.styles.css" asp-append-version="true" />
</head>

<body>

<header>
<h1>Sistema de Estancionamiento</h1>

<nav class="topbar">
<a asp-controller="Home" asp-action="Index">Inicio</a>
<a asp-controller="Home" asp-action="Dashboard">Dashboard</a>
<a asp-controller="Home" asp-action="Vehiculos">Vehiculos</a>
<a asp-controller="Home" asp-action="Entradas">Entradas</a>
<a asp-controller="Home" asp-action="Salidas">Salidas</a>
<a asp-controller="Home" asp-action="Horario">Horario</a>
<a asp-controller="Home" asp-action="Comentarios">Comentarios</a>
<a asp-controller="Home" asp-action="Reportes">Reportes</a>
</nav>
</header>

<div class="container">
<main role="main" class="pb-3">
@RenderBody()
</main>
</div>



<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>