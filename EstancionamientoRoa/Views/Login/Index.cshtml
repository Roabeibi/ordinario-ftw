@{
ViewData["Title"]="Login";
}

<div class="contenedor">

<h1>Login</h1>

<form method="post">

<p>Usuario</p>
<input type="text" name="usuario">

<br><br>

<p>Password</p>
<input type="password" name="password">

<br><br>

<button type="submit">Entrar</button>

</form>

<p style="color:red;">
@ViewBag.Error
</p>

</div>  