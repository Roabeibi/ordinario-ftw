@model List<EstancionamientoRoa.Models.Entrada>

@{
    ViewData["Title"] = "Entradas";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="contenedor">

    <h1>Entradas</h1>

    <form method="post" asp-action="GuardarEntrada">

        <p>Placa</p>

        <input type="text" name="placa" required />

        <br>
       <br>

        <p>Hora e entrada</p>
        <input type="text" name="horaEntrada" required />
        <br>
        <br>
        <p>Lugar</p>
        <input type="text" name="lugar" required />
        <br>
        <br>      <button type="submit">Guardar</button>
    </form>
    <hr>
    <h2>Lista de entradas</h2>
    <table border="1">
        <tr>
            <th>Placa</th>
            <th>Hora</th>
            <th>Lugar</th>
        </tr>
        @foreach (var entrada in Model)
        {
            <tr>
                <td>@entrada.Placa</td>
                <td>@entrada.HoraEntrada</td>
                <td>@entrada.Lugar</td>
            </tr>
        }
    </table>
</div>