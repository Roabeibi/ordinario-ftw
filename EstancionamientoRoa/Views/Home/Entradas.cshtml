@model List<EstancionamientoRoa.Models.Entrada>

@{
ViewData["Title"]="Entradas";
}

<link rel="stylesheet" href="~/css/site.css" />
<div class="contenedor">
<h1>Entradas</h1>
<p>
Vehiculos para registrar
</p>
<form method="post" asp-action="GuardarEntrada" onsubmit="return validarEntrada()">
<p>Placa</p>
<input type="text" name="placa" id="placa" required>
<p id="errorPlaca"></p>
<br>
<p>Modelo</p>
<input type="text" name="modelo" id="modelo" required>
<p id="errorModelo"></p>
<br>
<p>Hora de entrada</p>
<input type="text" name="horaEntrada" id="horaEntrada" required>
<p id="errorHora"></p>
<br>
<p>Lugar</p>
<input type="text" name="lugar" id="lugar" required>
<p id="errorLugar"></p>
>
<button type="submit">
Guardar entrada
</button>
</form>
<hr>
<h2>Vehiculos entrando</h2>
<table border="1">
<tr>
<th>Placa</th>
<th>Modelo</th>
<th>Hora</th>
<th>Lugar</th>
</tr>

@foreach(var entrada in Model)
{
<tr>
<td>@entrada.Placa</td>
<td>@entrada.Modelo</td>
<td>@entrada.HoraEntrada</td>
<td>@entrada.Lugar</td>
</tr>}
</table>
</div>
<script src="~/js/entradas.js"></script>