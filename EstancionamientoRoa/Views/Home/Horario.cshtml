<h2>Estado actual</h2>
<p id="estado"></p>
<p>
Hora actual
<span id="horaActual"></span>
</p>

</div>
<h2>Horarios</h2>
<table>
<tr>
<th>Día</th>
<th>Horario</th>
</tr>
<tr>
<td>Lunes</td>
<td>7:00 AM - 9:00 PM</td>
</tr>
<tr>
<td>Martes</td>
<td>7:00 AM - 9:00 PM</td>
</tr>
<tr>
<td>Miércoles</td>
<td>7:00 AM - 9:00 PM</td>
</tr>
<tr>
<td>Jueves</td>
<td>7:00 AM - 9:00 PM</td>
</tr>
<tr>
<td>Viernes</td>
<td>7:00 AM - 9:00 PM</td>
</tr>
<tr>
