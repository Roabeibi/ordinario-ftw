</tr>
</table>
<br>
<div class="info-box">
</div>
<h2>Fotos del estacionamiento</h2>
<div class="galeria">
<img src="~/img/parking.jpg"
alt="">
<img src="~/img/parking2.jpg"
alt="">
</div>
</div>
<script>
function actualizarHora()
{
let ahora = new Date();
let hora =
ahora.toLocaleTimeString();
document.getElementById("horaActual").innerHTML =
hora;
let dia = ahora.getDay();
let horas = ahora.getHours();
let abierto = false;
if(dia >= 1 && dia <= 5)
{
if(horas >= 7 && horas < 21)
{
abierto = true;
}
}
if(dia == 6)
{
if(horas >= 8 && horas < 18)
{
abierto = true;
}
}
if(abierto)
{
document.getElementById("estado").innerHTML =
"🟢 Abierto";
document.getElementById("estado").style.color =
"#28AD56";
}
else
{
document.getElementById("estado").innerHTML =
"🔴 Cerradisimo";
document.getElementById("estado").style.color =
"red";
}
}
actualizarHora();
setInterval(actualizarHora,1000);
</script>