@model List<EstancionamientoRoa.Models.Salida>

@{
    ViewData["Title"] = "Salidas";
}

<link rel="stylesheet" href="~/css/site.css" />
<div class="contenedor">
    <h1>Salidas</h1>

    <form method="post" asp-action="GuardarSalida">
        <label for="placa">Placa</label>
        <br>
        <input type="text" name="placa" id="placa" required>
        <br>
        <br>
        <label for="horaSalida">Hora de salida</label>
        <br>
        <input type="text" name="horaSalida" id="horaSalida" required>
        <br>
        <br>
        <label for="pago">Pago</label>
    <br>
        <input type="text" name="pago" id="pago" required>
        <br>
        <br>
        <button type="submit">
            Guardar
        </button>
    </form>
    <hr>
    <h2>Lista de salidas</h2>
    <table border="1">
        <tr>
            <th>Placa</th>
            <th>Hora</th>
            <th>Pago</th>
        </tr>
        @foreach (var salida in Model){
            <tr>
                <td>@salida.Placa</td>
                <td>@salida.HoraSalida</td>
                <td>@salida.Pago</td>
            </tr>}
    </table>
</div>