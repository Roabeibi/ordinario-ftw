@using EstancionamientoRoa.Controllers

@{
ViewData["Title"]="Vehiculos";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="contenedor">
<h1>Vehiculos registrados</h1>
<p>
Lista de vehiculos registrados desde entradas.
</p>
<input type="text" id="buscarVehiculo" placeholder="Buscar placa">
<button onclick="filtrarVehiculos()">
Buscar
</button>
<br>
<br>
<table border="1" id="tablaVehiculos">
<tr>
<th>Placa</th>
<th>Modelo</th>
<th>Lugar</th>
</tr>
@foreach(var entrada in HomeController.listaEntradas){
<tr>
<td>@entrada.Placa</td>
<td>@entrada.Modelo</td>
<td>@entrada.Lugar</td>
</tr>}

</table>

</div>

<script src="~/js/vehiculos.js"></script>