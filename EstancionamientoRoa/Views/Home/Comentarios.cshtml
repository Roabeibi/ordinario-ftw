@model List<EstancionamientoRoa.Models.Comentario>
@{ViewData["Title"] = "Comentarios";}
<link rel="stylesheet" href="~/css/site.css" />

    <h1>Comentarios</h1>
    <form method="post" asp-action="GuardarComentario">
        <p>Nombre</p>
        <input type="text" name="nombre" required />
        <br>
        <br>
        <p>Comentario</p>
        <textarea name="mensaje" required></textarea>
        <br>
        <br>
        <button type="submit">Guardar</button>
    </form>
    <hr>
    <h2>Comentarios guardados</h2>
 <table id="tablaComentarios" border="1">
<tr>
<th>Nombre</th>
<th>Comentario</th>
</tr>
@foreach (var comentario in Model)
{
<tr>
<td>@comentario.Nombre</td>
<td>@comentario.Mensaje</td>
</tr>}
</table>
</div>