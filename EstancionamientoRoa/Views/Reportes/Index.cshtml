@{
ViewData["Title"]="Reportes";
}

<div class="contenedor">

<h1>Reportes</h1>

<table>
<tr>
<th>Dato</th>
<th>Cantidad</th>
</tr>

<tr>
<td>Vehículos</td>
<td>@ViewBag.TotalVehiculos</td>
</tr>

<tr>
<td>Entradas</td>
<td>@ViewBag.TotalEntradas</td>
</tr>

<tr>
<td>Salidas</td>
<td>@ViewBag.TotalSalidas</td>
</tr>

<tr>
<td>Ingresos</td>
<td>$@ViewBag.IngresoTotal</td>
</tr>

</table>

</div>